{
  "name": "blackjack-assistant",
  "productName": "Blackjack Assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Watches your blackjack game and recommends your next move",
  "author": "Blackjack Assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leweyy/blackjack-assistant.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run dist && node scripts/release.mjs"
  },
  "build": {
    "appId": "com.blackjackassistant.app",
    "productName": "Blackjack Assistant",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BlackjackAssistant-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "BlackjackAssistant-${version}-portable.exe"
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "BlackjackAssistant-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
